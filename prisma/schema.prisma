// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  // pi network platform user credentials
  username    String
  accessToken String
  uid         String @unique

  isActive      Boolean @default(true)
  /// points accrued for active ecosystem participation / bought
  points        Float   @default(10)
  /// username of user's referrer
  referrer      String?
  /// no of users referred
  noOfReferrals Int     @default(0)

  // Relationships
  plantedTrees      Tree[]
  treeVerifications TreeVerification[]
  createdBounties   LocalBounty[]       @relation("CreatedBounties")
  bountyRewards     ParticipantReward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tree {
  id             String     @id @default(cuid())
  code           String     @unique @default(uuid())
  additionalInfo String?
  latitude       Float
  longitude      Float
  status         TreeStatus @default(PLANTED)

  isAuthentic   Boolean   @default(false)
  rewardClaimed Boolean   @default(false)
  dateVerified  DateTime?

  planter   User   @relation(fields: [planterId], references: [id])
  planterId String

  mediaEvidence Media[]
  verifications TreeVerification[]
  localBounty   LocalBounty?       @relation(fields: [localBountyId], references: [id])
  localBountyId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TreeVerification {
  id              String  @id @default(cuid())
  rewardClaimed   Boolean @default(false)
  treeIsAuthentic Boolean
  additionalInfo  String?

  mediaEvidence Media[]

  tree       Tree   @relation(fields: [treeId], references: [id])
  treeId     String
  verifier   User   @relation(fields: [verifierId], references: [id])
  verifierId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([treeId, verifierId])
}

model Media {
  id     String    @id @default(cuid())
  url    String    @unique
  type   MediaType
  handle String?

  treeVerification   TreeVerification? @relation(fields: [treeVerificationId], references: [id])
  treeVerificationId String?
  tree               Tree?             @relation(fields: [treeId], references: [id])
  treeId             String?
}

model Pot {
  id              String  @id @default(cuid())
  name            String  @unique
  balance         Float   @default(0)
  revenueFraction Float   @default(0)
  walletAddress   String?
  isPublic        Boolean @default(true)
  isOpen          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  amount     Float
  txId       String?
  paymentId  String              @unique
  isRefunded Boolean             @default(false)
  type       PiTransactionType
  status     PiTransactionStatus @default(INITIALIZED)
  purposeId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LocalBounty {
  id            String  @id @default(cuid())
  title         String
  /// Additional information about the bounty to help participants
  description   String?
  /// total Pi tokens offered
  totalBounty   Float
  /// total Pi tokens claimed
  bountyClaimed Float   @default(0)

  /// tree planting distance from center allowed in kilometers
  radius          Float
  centerLatitude  Float
  centerLongitude Float
  /// Bounty address gotten from  reverse coding center using Geolocation API 
  location        String?

  startDate DateTime
  endDate   DateTime

  /// Payment PaymentId (only added when payment completed)
  paymentId String?

  creatorId String
  creator   User   @relation("CreatedBounties", fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trees              Tree[]
  participantRewards ParticipantReward[]
}

model ParticipantReward {
  id String @id @default(cuid())

  localBountyId String
  localBounty   LocalBounty @relation(fields: [localBountyId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])

  treesPlanted  Int     @default(0) // Number of trees planted
  treesVerified Int     @default(0) // Number of trees verified
  isClaimed     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique(name: "bountyRewardId", [localBountyId, userId])
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PiTransactionType {
  DONATE
  SUBSCRIBE
  LOCAL_BOUNTY
  CLAIM_REWARD
}

enum PiTransactionStatus {
  INITIALIZED
  COMPLETED
  CANCELLED
}

enum TreeStatus {
  PLANTED
  LISTED
  VERIFYING
  VERIFIED
  PLANTERS_PAID
  VERIFIERS_PAID
  MATURED
}

enum RewardType {
  PLANTER
  VERIFIER
}
